rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAccountActive(userId) {
      return !get(/databases/$(database)/documents/users/$(userId)).data.banned;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isSafeUserCreate(userId) {
      return isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'username',
          'displayName',
          'email',
          'avatar',
          'avatarPath',
          'role',
          'banned',
          'banReason',
          'bannedAt',
          'bannedBy',
          'unbannedAt',
          'unbannedBy',
          'stats',
          'settings',
          'preferences',
          'createdAt',
          'lastLoginAt',
          'updatedAt',
          'lastActiveAt'
        ])
        && request.resource.data.role == 'player'
        && request.resource.data.username is string;
    }

    function hasOnlyMutableUserFields() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'displayName',
        'avatar',
        'avatarPath',
        'preferences',
        'settings',
        'updatedAt',
        'lastActiveAt',
        'lastLoginAt'
      ]);
    }

    function isSafeUserUpdate(userId) {
      return isOwner(userId)
        && hasOnlyMutableUserFields()
        && request.resource.data.role == resource.data.role
        && request.resource.data.username == resource.data.username
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.banned == resource.data.banned
        && request.resource.data.banReason == resource.data.banReason
        && request.resource.data.bannedAt == resource.data.bannedAt
        && request.resource.data.bannedBy == resource.data.bannedBy
        && request.resource.data.unbannedAt == resource.data.unbannedAt
        && request.resource.data.unbannedBy == resource.data.unbannedBy;
    }

    function isSafePublicProfileCreate(userId) {
      return isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'uid',
          'username',
          'displayName',
          'avatar',
          'avatarPath',
          'isPrivateLeaderboard',
          'preferences',
          'createdAt',
          'updatedAt',
          'lastActiveAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.username is string
        && get(/databases/$(database)/documents/users/$(userId)).data.username == request.resource.data.username;
    }

    function hasOnlyMutablePublicProfileFields() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'displayName',
        'avatar',
        'avatarPath',
        'isPrivateLeaderboard',
        'preferences',
        'updatedAt',
        'lastActiveAt'
      ]);
    }

    function isSafePublicProfileUpdate(userId) {
      return isOwner(userId)
        && hasOnlyMutablePublicProfileFields()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == resource.data.username
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function isLinkedUsernameReservation(username) {
      return isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.username == username
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
    }

    function isValidGameMode(mode) {
      return mode == 'classic'
        || mode == 'classic_transparent'
        || mode == 'vsai'
        || mode == 'multiplayer';
    }

    function isValidGameDifficulty(mode, difficulty) {
      return (
        mode == 'vsai'
        && (
          difficulty == 'easy'
          || difficulty == 'medium'
          || difficulty == 'impossible'
        )
      ) || (
        mode != 'vsai'
        && difficulty == null
      );
    }

    function isValidGameResult(result) {
      return result == 'completed'
        || result == 'won'
        || result == 'lost'
        || result == 'quit'
        || result == 'victory'
        || result == 'defeat';
    }

    function isSafeGameCreate() {
      return isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.gameId is string
        && request.resource.data.gameId.size() > 0
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 64
        && request.resource.data.mode is string
        && isValidGameMode(request.resource.data.mode)
        && isValidGameDifficulty(request.resource.data.mode, request.resource.data.difficulty)
        && request.resource.data.playerCount is int
        && request.resource.data.playerCount >= 1
        && request.resource.data.playerCount <= 4
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1000000
        && request.resource.data.duration is int
        && request.resource.data.duration >= 0
        && request.resource.data.duration <= 86400
        && request.resource.data.foodEaten is int
        && request.resource.data.foodEaten >= 0
        && request.resource.data.foodEaten <= 100000
        && request.resource.data.speedReached is number
        && request.resource.data.speedReached >= 1
        && request.resource.data.speedReached <= 100
        && request.resource.data.result is string
        && isValidGameResult(request.resource.data.result);
    }

    // Users collection - users can only read/write their own data
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || isSafeUserUpdate(userId);
      allow delete: if isAdmin();

      // Friends subcollection - owner can manage their own friend edges
      match /friends/{friendId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || request.auth.uid == friendId || isAdmin());
        allow create: if isSignedIn()
          && (
            request.auth.uid == userId ||
            (request.auth.uid == friendId && request.resource.data.status == 'pending_received') ||
            isAdmin()
          );
        allow update, delete: if isSignedIn() && (request.auth.uid == userId || request.auth.uid == friendId || isAdmin());
      }
    }

    // Public profiles - safe, non-sensitive fields only
    match /publicProfiles/{userId} {
      allow read: if true;
      allow create: if isAdmin() || isSafePublicProfileCreate(userId);
      allow update: if isAdmin() || isSafePublicProfileUpdate(userId);
      allow delete: if isAdmin();
    }

    // Username reservations - one username per user, immutable doc id
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAdmin()
        || (
          isLinkedUsernameReservation(username)
          && !exists(/databases/$(database)/documents/usernames/$(username))
        );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Games collection - server-owned writes via Cloud Functions only
    match /games/{gameId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // Leaderboards collection - Shared documents for all users
    // Since these are shared documents (e.g., 'classic_medium'), we cannot restrict by userId.
    // authenticated users must be able to update the shared leaderboard.
    match /leaderboards/{leaderboardId} {
      allow read: if true; 
      allow write: if false;
    }

    // Weekly leaderboards are generated by Cloud Functions and read publicly.
    match /weeklyLeaderboards/{leaderboardId} {
      allow read: if true;
      allow write: if false;
    }

    // Achievements collection - authenticated users only
    match /achievements/{achievementId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Support tickets - users create/read their own tickets, admins can manage all
    match /supportTickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Email OTPs - server-side only
    match /emailOtps/{docId} {
      allow read, write: if false;
    }

    // Prevent access to any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

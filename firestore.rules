rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - users can only read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    // Games collection - authenticated users can read/write game sessions
    match /games/{gameId} {
      allow read, write: if request.auth != null;
      allow create: if request.auth != null;
    }

    // Leaderboards collection - public read, authenticated write
    match /leaderboards/{leaderboardId} {
      allow read: if true; // Public read access for leaderboards
      allow write: if request.auth != null; // Only authenticated users can update
    }

    // Achievements collection - authenticated users only
    match /achievements/{achievementId} {
      allow read, write: if request.auth != null;
    }

    // Prevent access to any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
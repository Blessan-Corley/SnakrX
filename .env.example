# SnakrX Environment Variables Configuration
#
# IMPORTANT: Copy this file to .env and fill in your actual values
# Do NOT commit .env file to version control
#
# Firebase Configuration
# Get these values from: https://console.firebase.google.com/
# Project Settings > General > Your apps > Firebase SDK snippet > Config

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Example (DO NOT USE THESE - GET YOUR OWN FROM FIREBASE):
# VITE_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# VITE_FIREBASE_AUTH_DOMAIN=snakrx-game.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=snakrx-game
# VITE_FIREBASE_STORAGE_BUCKET=snakrx-game.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
# VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
# VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

{
  "name": "snakrx",
  "version": "1.0.0",
  "description": "SnakrX - Modern Snake Game with Multiple Modes",
  "type": "module",
  "main": "src/main.jsx",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "vite --force",
    "build": "vite build",
    "preview": "vite preview",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4173",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "analyze": "vite build --mode analyze && npx vite-bundle-analyzer dist",
    "ci:quality": "npm run lint && npm run test:coverage && npm run build",
    "verify:release": "npm run ci:quality",
    "check:deploy-env": "node scripts/check-deploy-env.cjs",
    "deploy:hosting": "npm run check:deploy-env && npm run verify:release && firebase deploy --only hosting",
    "deploy:firebase": "npm run check:deploy-env && npm run verify:release && firebase deploy --only firestore:rules,firestore:indexes,storage,functions,hosting",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage && node scripts/check-coverage.cjs",
    "test:e2e": "playwright test",
    "e2e:public": "playwright test e2e/public-pages.spec.js e2e/navigation.spec.js e2e/pwa-and-session.spec.js",
    "e2e:auth": "playwright test e2e/auth.spec.js e2e/friends.spec.js e2e/game-classic.spec.js e2e/game-modes.spec.js e2e/gameplay.spec.js e2e/navigation-auth.spec.js e2e/pwa-auth.spec.js"
  },
  "dependencies": {
    "baseline-browser-mapping": "^2.9.19",
    "caniuse-lite": "^1.0.30001767",
    "firebase": "^10.7.1",
    "framer-motion": "^10.16.16",
    "lucide-react": "^0.303.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.0.4",
    "@vitest/ui": "^1.0.4",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^23.0.1",
    "postcss": "^8.4.32",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^3.4.0",
    "terser": "^5.43.1",
    "vite": "^5.0.8",
    "vite-bundle-analyzer": "^0.11.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^1.0.4"
  }
}

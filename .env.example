# SnakrX Environment Variables Configuration
#
# IMPORTANT: Copy this file to .env and fill in your actual values
# Do NOT commit .env file to version control
#
# Firebase Configuration
# Get these values from: https://console.firebase.google.com/
# Project Settings > General > Your apps > Firebase SDK snippet > Config

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
# Use the bucket in appspot.com form for Firebase Storage web uploads.
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Cloud Functions mail + OTP configuration
# Local development can read these from the root .env via functions/src/runtime.js.
# Production deploys must set equivalent values in the Firebase Functions environment.
EMAIL_USER=your_smtp_or_gmail_user_here
EMAIL_PASS=your_smtp_or_gmail_password_here
EMAIL_FROM=SnakrX <no-reply@example.com>
SUPPORT_EMAIL_TO=support@example.com
OTP_SALT=replace_with_a_long_random_secret

# Optional Playwright E2E credentials
# Use a real app-ready account created through the normal signup flow.
# These tests now expect the account to already have Firestore profile records.
E2E_EMAIL=your_e2e_email_here
E2E_PASSWORD=your_e2e_password_here

